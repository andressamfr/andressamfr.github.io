---
import "../styles/global.css";
import Header from '../components/Header.astro'
import Footer from "../components/Footer.astro";

const title = "Andressa M. Fernandes"
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body class="bg-[#FFF7ED] text-[#675E50] font-poppins">
    <div class="relative w-full overflow-hidden">
        <Header></Header>

        <main class="mt-screen relative w-full">
            <slot />
        </main>
    </div>
    
    <Footer></Footer>
</body>
</html>